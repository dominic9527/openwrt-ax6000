
#!/bin/sh
# Redmi AX6000
# First boot PBR configuration
# DirectBridge -> br-direct -> 192.168.2.1

TAG="pbr-directbridge"

# PBR must be installed
if [ ! -x /etc/init.d/pbr ]; then
    logger -t "$TAG" "PBR not installed, waiting."
    exit 1
fi

# Verify DirectBridge device
if [ "$(uci -q get network.DirectBridge.device)" != "br-direct" ]; then
    logger -t "$TAG" "DirectBridge device not ready, waiting."
    exit 1
fi

# Verify DirectBridge gateway
if [ "$(uci -q get network.DirectBridge.gateway)" != "192.168.2.1" ]; then
    logger -t "$TAG" "DirectBridge gateway not ready, waiting."
    exit 1
fi

# Configure PBR uplink
uci set pbr.config.uplink_interface='DirectBridge'
uci commit pbr

# Enable PBR at boot
/etc/init.d/pbr enable

logger -t "$TAG" "PBR uplink configured: DirectBridge"

exit 0
