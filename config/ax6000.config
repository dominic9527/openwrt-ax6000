
# ==========================================================
# Redmi AX6000 U-Boot Mod
# Official OpenWrt 25.12.6 Stable
# MediaTek Filogic / Open-source mt76
#
# English LuCI / HTTPS / WireGuard / PBR / Full DNS
# ==========================================================


# ----------------------------------------------------------
# 1. Target device
# ----------------------------------------------------------

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y


# ----------------------------------------------------------
# 2. LuCI Web interface - English / OpenSSL HTTPS
# ----------------------------------------------------------

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-firewall=y

# No Simplified Chinese
# CONFIG_LUCI_LANG_zh_Hans is not set


# ----------------------------------------------------------
# 3. WireGuard Server
# ----------------------------------------------------------

CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y


# ----------------------------------------------------------
# 4. Network diagnostics
# ----------------------------------------------------------

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y


# ----------------------------------------------------------
# 5. Policy Based Routing
# ----------------------------------------------------------

CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y


# ----------------------------------------------------------
# 6. Full DNS - dnsmasq-full
#
# DHCP / DHCPv6 / DNSSEC / Authoritative DNS
# IPset / NFTset / Conntrack / NO_ID / TFTP
# ----------------------------------------------------------

# Disable default dnsmasq selection
# CONFIG_DEFAULT_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq is not set

# Select dnsmasq-full
CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y

# nftables JSON support
CONFIG_PACKAGE_nftables-json=y


# ----------------------------------------------------------
# 7. IPv6
# ----------------------------------------------------------

CONFIG_IPV6=y


# ----------------------------------------------------------
# 8. Minimal build
#
# No Tailscale
# No OpenVPN
# No Docker
# No NAS packages
# No manually selected USB / Bluetooth packages
# Open-source mt76 driver
# ----------------------------------------------------------
