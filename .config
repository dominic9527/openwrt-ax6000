
# ==================================================
# Redmi AX6000 - Official OpenWrt 25.12
# U-Boot mod / mt76 open-source Wi-Fi driver
# ==================================================

# Target
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y

# --------------------------------------------------
# LuCI Web management
# --------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# --------------------------------------------------
# WireGuard Server
# --------------------------------------------------
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# --------------------------------------------------
# Network diagnostics
# --------------------------------------------------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y

# --------------------------------------------------
# Keep PBR independent
# --------------------------------------------------
# CONFIG_PACKAGE_pbr is not set
# CONFIG_PACKAGE_luci-app-pbr is not set

# --------------------------------------------------
# Do not select unnecessary services
# --------------------------------------------------
# No Tailscale
# No OpenVPN
# No Docker
# No NAS packages
# No Bluetooth
# No USB packages selected manually
